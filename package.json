{
  "name": "hrkvoice-monorepo",
  "version": "1.0.0",
  "description": "HRKVoice - India-First Multilingual AI Voice Productivity Desktop Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/desktop",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "dev:web": "npm run dev --workspace=apps/web-dashboard",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=apps/web-dashboard",
    "build:all": "npm run build --workspaces --if-present",
    "build:packages": "npm run build --workspace=packages/shared --workspace=packages/utilities --workspace=packages/speech --workspace=packages/ai --workspace=packages/dictionary --workspace=packages/context",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "build:web": "npm run build --workspace=apps/web-dashboard",
    "build:server": "npm run build --workspace=server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx",
    "package": "npm run package --workspace=apps/desktop",
    "package:dir": "npm run package:dir --workspace=apps/desktop"
  },
  "keywords": [
    "voice-to-text",
    "ai",
    "multilingual",
    "india",
    "hinglish",
    "electron",
    "speech-recognition",
    "productivity"
  ],
  "author": "HRKVoice Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
