# ====================================================================
# HRKVoice - Environment Configuration Template
# ====================================================================
# Notice: Copy this file to .env and configure keys as needed.
# HRKVoice includes a local Offline/Demo Mode that functions WITHOUT any API keys.
# To connect to live cloud speech and AI processing engines, set the relevant keys below.
# ====================================================================

# Port for HRKVoice Local Backend Service
PORT=4321
NODE_ENV=development

# --------------------------------------------------------------------
# AI Processing Provider Keys (Choose your preferred AI cleanup provider)
# --------------------------------------------------------------------
# Primary AI Provider: 'openai' | 'groq' | 'gemini' | 'anthropic' | 'mock'
DEFAULT_AI_PROVIDER=mock

# OpenAI API Key (for GPT-4o, GPT-4o-mini formatting & cleanup)
OPENAI_API_KEY=

# Groq API Key (for ultra-low latency Llama-3.3-70b-versatile AI cleanup)
GROQ_API_KEY=

# Google Gemini API Key (for Gemini 2.0 Flash / Pro multimodal cleanup)
GEMINI_API_KEY=

# Anthropic Claude API Key (for Claude 3.5 Sonnet / Haiku cleanup)
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------
# Speech-To-Text Provider Keys
# --------------------------------------------------------------------
# Primary Speech Provider: 'groq' | 'openai' | 'deepgram' | 'google' | 'mock'
DEFAULT_SPEECH_PROVIDER=mock

# Groq Whisper API Key (Whisper large-v3 - fast transcription for Indian languages)
GROQ_SPEECH_API_KEY=

# OpenAI Whisper API Key (whisper-1 endpoint)
OPENAI_SPEECH_API_KEY=

# Deepgram API Key (nova-2 multilingual streaming speech-to-text)
DEEPGRAM_API_KEY=

# Google Cloud Speech-to-Text API Key or Credentials JSON path
GOOGLE_SPEECH_API_KEY=

# --------------------------------------------------------------------
# Storage & Database
# --------------------------------------------------------------------
# Local SQLite database path (defaults to user data directory if omitted)
DATABASE_URL=./hrkvoice.sqlite
AUTH_SECRET=hrkvoice-dev-secret-change-in-production-32chars

# --------------------------------------------------------------------
# Optional Telemetry & Diagnostics (Opt-in only, no transcripts sent)
# --------------------------------------------------------------------
ANALYTICS_ENABLED=false
ANALYTICS_KEY=

# --------------------------------------------------------------------
# Application Settings Defaults
# --------------------------------------------------------------------
DEFAULT_INPUT_LANGUAGE=auto
DEFAULT_OUTPUT_LANGUAGE=same_as_spoken
DEFAULT_WRITING_MODE=general
PUSH_TO_TALK_SHORTCUT=CommandOrControl+Alt+Space
ENABLE_CONTEXT_AWARENESS=true
AUTO_RESTORE_CLIPBOARD=true
